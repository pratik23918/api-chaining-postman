  "item": [
    {
      "name": "Post Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r",
              "pm.environment.set(\"userid_env\", jsonData.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var random = Math.random().toString(36).substring(2);\r",
              "\r",
              "var username = \"ab\"+random;\r",
              "var useremail = \"ab\" + random + \"@gmail.com\";\r",
              "\r",
              "pm.environment.set(\"email_env\", useremail);\r",
              "pm.environment.set(\"user_env\", username);\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n\"name\": \"{{user_env}}\",\r\n\"email\": \"{{email_env}}\",\r\n\"gender\": \"male\",\r\n\"status\": \"active\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://gorest.co.in/public/v2/users",
          "protocol": "https",
          "host": [
            "gorest",
            "co",
            "in"
          ],
          "path": [
            "public",
            "v2",
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//validating the name, email and id which we received from post method\r",
              "\r",
              "pm.test(\"post entities validating\", ()=>{\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "pm.expect(jsonData.id).to.eql(pm.environment.get(\"userid_env\"));\r",
              "\r",
              "pm.expect(jsonData.email).to.eqls(pm.environment.get(\"email_env\"));\r",
              "\r",
              "pm.expect(jsonData.name).to.eqls(pm.environment.get(\"user_env\"));\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://gorest.co.in/public/v2/users/{{userid_env}}",
          "protocol": "https",
